# R10 Worker Daemon Environment Variables
#
# The local cluster runs 4 daemons on ports 8081-8084; PORT and WORKER_NAME are
# normally overridden per instance (godotenv never overrides an existing env var),
# and the addresses must match services.ClusterTopology in the gateway.
PORT=8081
CLUSTER_ROOT_DIR=/tmp/r10_cluster
WORKER_NAME=wkr10_1
